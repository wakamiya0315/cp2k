&GLOBAL
  PROJECT Al_kpoint_otdiag_maxiter
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &KPOINTS
      SCHEME MONKHORST-PACK 3 3 3
      GAMMA_CENTERED TRUE
      SYMMETRY FALSE
      FULL_GRID FALSE
      WAVEFUNCTIONS COMPLEX
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
    &END MGRID
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 60
      IGNORE_CONVERGENCE_FAILURE TRUE
      ADDED_MOS 6
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE 1000
      &END SMEAR
      &DIAGONALIZATION
        ALGORITHM OT
        EPS_ITER 1.0E-14
        MAX_ITER 1
        &OT
          ALGORITHM STRICT
          MINIMIZER CG
          PRECONDITIONER FULL_ALL
        &END OT
      &END DIAGONALIZATION
      &MIXING
        METHOD DIRECT_P_MIXING
        PULAY_P
        ALPHA 0.1
        NBUFFER 8
      &END MIXING
      &PRINT
        &RESTART
          ADD_LAST NUMERIC
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &MO
        EIGENVALUES TRUE
        OCCUPATION_NUMBERS TRUE
        ADD_LAST NUMERIC
      &END MO
    &END PRINT
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 2.8637824638 2.8637824638 2.8637824638
      ALPHA_BETA_GAMMA 60 60 60
      PERIODIC XYZ
    &END CELL
    &COORD
      Al 0 0 0
    &END COORD
    &KIND Al
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
